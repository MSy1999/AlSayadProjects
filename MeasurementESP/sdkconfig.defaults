# DevKitC V4 / WROOM-32E reference hardware; actual flash capacity still needs verification.
CONFIG_IDF_TARGET="esp32"
CONFIG_AS_SENDER_PERIOD_MS=2500
CONFIG_AS_SENDER_HTTP_TIMEOUT_MS=3000
# CONFIG_AS_SENDER_SIMULATED is not set
CONFIG_AS_SENDER_DHT_ENABLED=y
CONFIG_AS_SENDER_LIGHT_ENABLED=y
CONFIG_AS_SENDER_LIGHT_CALIBRATED=y
CONFIG_AS_SENDER_LIGHT_DARK_RAW=4095
CONFIG_AS_SENDER_LIGHT_BRIGHT_RAW=12
CONFIG_AS_SENDER_DHT_GPIO_CAPTURE=y

# Keep serial output to warnings and errors.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
