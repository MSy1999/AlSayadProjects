CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_XPT2046_CONVERT_ADC_TO_COORDS is not set
# CONFIG_XPT2046_INTERRUPT_MODE is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
# CONFIG_SPIRAM is not set

CONFIG_LV_USE_BIDI=y

CONFIG_LV_USE_ARABIC_PERSIAN_CHARS=y

CONFIG_LV_USE_CHART=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_CJSON_NESTING_LIMIT=16
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

CONFIG_LV_USE_FONT_COMPRESSED=y
